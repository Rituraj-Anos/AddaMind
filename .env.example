# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Model chains, comma-separated provider:model, tried in order. Defaults are in the code.
# ADDAMIND_AGENT_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite
# ADDAMIND_MEMORY_CHAIN=gemini:gemini-3.5-flash-lite,nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
# ADDAMIND_VISION_MODEL=gemini-3.5-flash-lite
# ADDAMIND_TTS_MODEL=gemini-3.8-flash-lite-tts

# Where the database and media live (default .cache). Point it at a persistent disk when hosting.
# ADDAMIND_DATA=/var/data

# Switches (on by default). "off" skips that stage: useful offline or to save free quota.
# ADDAMIND_EMBEDDINGS=off
# ADDAMIND_MEDIA=off
# ADDAMIND_MEMORY=off
# ADDAMIND_MEDIA_CAP=500

LLM_TIMEOUT_S=30
NVIDIA_TIMEOUT_S=60
GROQ_MAX_PROMPT_TOKENS=6000

# Browser origins allowed to call the API. Localhost on any port is allowed by default.
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=
