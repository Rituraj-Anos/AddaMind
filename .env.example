# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# OpenRouter free router/models (OpenAI-compatible). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model fallback order: provider:model, comma-separated. Providers: gemini, groq, nvidia, ollama.
# The last model that worked is tried first for LLM_STICKY_TTL_S seconds.
LLM_CHAIN=gemini:gemini-3.8-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3.5-lightning:free,openrouter:openrouter/auto,nvidia:mistralai/mistral-large-4-1t-a52b
LLM_STICKY_TTL_S=900
LLM_TIMEOUT_S=30
NVIDIA_TIMEOUT_S=60
OPENROUTER_TIMEOUT_S=45
# Groq free tier is ~8000 tokens/minute; larger prompts skip Groq.
GROQ_MAX_PROMPT_TOKENS=6000

# API (backend/api/main.py). Browser origins allowed to call the API.
# Localhost on any port is allowed by default. For deployment add the frontend URL:
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=
# Overrides the default localhost regex, e.g. https://your-app(-[a-z0-9-]+)?\.vercel\.app for previews.
# CORS_ORIGIN_REGEX=
